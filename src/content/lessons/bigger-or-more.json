  "goals": [
    {
      "text": "Scale up and know what it buys",
      "step": 2
    },
    {
      "text": "Spot the ceiling and the single point of failure",
      "step": 4
    },
    {
      "text": "Scale out behind a load balancer and plan for N+1",
      "step": 6
    },
    {
      "text": "See where the bottleneck moves next",
      "step": 7
    }
  ],
  "steps": [
