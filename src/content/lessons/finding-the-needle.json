  "goals": [
    {
      "text": "See why a query without an index reads every row",
      "step": 1
    },
    {
      "text": "Understand how a B-tree finds one row in a few page reads",
      "step": 3
    },
    {
      "text": "Design a composite index and know its column-order rule",
      "step": 4
