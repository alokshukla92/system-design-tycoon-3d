  "goals": [
    {
      "text": "See why in-memory sessions break with two servers",
      "step": 1
    },
    {
      "text": "Weigh sticky sessions",
      "step": 3
    },
    {
      "text": "Make servers stateless with a shared store or tokens",
      "step": 5
