            "cpu": 0.2
          },
          "card": {
            "type": "panel",
            "title": "One page load",
            "icon": "listOrdered",
            "lines": [
              "1  DNS — find the address",
              "2  TCP — open a connection",
              "3  TLS — make it private",
              "4  Request — ask, server works",
              "5  Download — the bytes arrive",
              "# each job waits for the previous one"
            ]
          }
        },
