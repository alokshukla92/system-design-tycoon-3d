{
  "id": "not-so-fast",
  "title": "Not So Fast",
  "summary": "Ledgerly, an invoicing app for small firms, knows who you are. The harder question: what are you allowed to see and do — and who checks it, on which request?",
  "minutes": 10,
  "level": "intermediate",
  "metrics": [
    "exposed",
    "checks",
    "privilege"
  ],
  "legend": [
    "req",
    "res",
