            "y": -12,
            "s": 3.6,
            "color": "blue",
            "glyph": "server",
            "label": [
              "Invoices",
              "API"
            ],
            "cpu": 0.3
          },
          "db": {
            "type": "db",
            "x": -4,
            "y": 4,
            "label": "Invoices DB",
            "tags": [
              {
                "text": "all tenants, one table",
                "tone": "paper",
                "icon": "layers"
              }
