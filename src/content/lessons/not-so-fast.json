    ],
    [
      "ping",
      "policy check"
    ],
    "fail"
  ],
  "goals": [
    {
      "text": "Tell authentication apart from authorization",
      "step": 0
    },
    {
      "text": "Find and fix an IDOR with a server-side check",
      "step": 2
    },
    {
      "text": "Model permissions with RBAC and ABAC",
      "step": 4
    },
    {
      "text": "Centralise policy and limit what services can reach",
      "step": 8
    }
  ],
  "steps": [
